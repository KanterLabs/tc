[Unit]
Description=Helm project board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roadmap
Group=roadmap
EnvironmentFile=/etc/roadmap/roadmap.env
ExecStart=/usr/local/sbin/helm-run-current
WorkingDirectory=/var/lib/roadmap/data
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0027

# The binary and its embedded migrations are immutable; only the SQLite data
# directory is writable by the service account.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=1536M
TasksMax=256
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/roadmap/data

[Install]
WantedBy=multi-user.target
Alias=roadmap.service
