HELM_ADDR=127.0.0.1:8080
HELM_DB=/var/lib/roadmap/data/roadmap.db
HELM_LUNA_ENABLED=true
HELM_LUNA_MODEL=gpt-5.6-luna
HELM_LUNA_EFFORT=medium
HELM_AUTH_MODE=cloudflare
HELM_PUBLIC_ORIGIN=@PUBLIC_ORIGIN@
HELM_ADMIN_EMAIL=@OWNER_EMAIL@
# Access JWT validation is pinned to the team issuer and both protected
# application audience tags (the UI host and /api/v1/* path app).
HELM_CLOUDFLARE_ISSUER=@CLOUDFLARE_ISSUER@
HELM_CF_ACCESS_AUDIENCES=@UI_AUDIENCE@,@API_AUDIENCE@
HELM_SECURE_COOKIES=true
HELM_DEMO_SEED=false
# Retained Roadmap binaries consume these equal-value compatibility aliases.
ROADMAP_ADDR=127.0.0.1:8080
ROADMAP_DB=/var/lib/roadmap/data/roadmap.db
ROADMAP_AUTH_MODE=cloudflare
ROADMAP_PUBLIC_ORIGIN=@PUBLIC_ORIGIN@
ROADMAP_ADMIN_EMAIL=@OWNER_EMAIL@
ROADMAP_CLOUDFLARE_ISSUER=@CLOUDFLARE_ISSUER@
ROADMAP_CF_ACCESS_AUDIENCES=@UI_AUDIENCE@,@API_AUDIENCE@
ROADMAP_SECURE_COOKIES=true
ROADMAP_DEMO_SEED=false
