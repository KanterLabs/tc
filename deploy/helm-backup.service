[Unit]
Description=Verified Helm SQLite backup
After=helm.service
RequiresMountsFor=/var/lib/roadmap/data /var/lib/roadmap/backups

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/helm-backup daily
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/var/lib/roadmap/data /var/lib/roadmap/backups

[Install]
Alias=roadmap-backup.service
