# Beta deployment profile. Invoke deploy-ci.sh with
# HELM_DEPLOY_ENVIRONMENT=beta so this environment can never reuse the
# production deployment account, gateway, signing trust, or guest.
PVE_HOST=10.0.0.20
PVE_DEPLOY_USER=helm-beta-deploy
CTID=106
CT_NAME=helm-beta
CT_IP=10.0.0.39
CT_GATEWAY=10.0.0.1
CT_CIDR_PREFIX=24
PVE_TEMPLATE=local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst
PVE_STORAGE=local-lvm
PVE_BRIDGE=vmbr0
CT_MEMORY_MB=2048
CT_DISK_GB=16

# The beta origin must have its own Cloudflare tunnel/access policy and owner
# environment. The release bundle is otherwise installed by the same guest
# installer, but this CT has its own database, secrets, and retained releases.
HELM_PUBLIC_ORIGIN=https://beta.shanekanterman.dev
HELM_ADMIN_EMAIL=owner@example.com
HELM_RELEASE_RETENTION=5
HELM_BACKUP_RETENTION=14
